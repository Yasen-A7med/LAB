{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/uv/service/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/((?!api/|uv/|epoxy/|baremux/|bare/|assets/).*)",
      "destination": "/index.html"
    }
  ]
}
