{
  "rewrites": [
    {
      "source": "/uv/service/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/((?!api/|uv/|epoxy/|baremux/|bare/|assets/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/**/*.js": {
      "runtime": "@vercel/node@3"
    }
  }
}
