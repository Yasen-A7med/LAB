{
  "redirects": [
    {
      "source": "/(.*)\\.zip",
      "destination": "/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/apmail/(.*)",
      "destination": "/api/apmail?path=$1"
    },
    {
      "source": "/uv/service/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/((?!api/|uv/|epoxy/|baremux/|bare/|assets/|thanawya/).*)",
      "destination": "/index.html"
    }
  ]
}
