{
  "rewrites": [
    {
      "source": "/api/yd/info",
      "destination": "/api/yd_info.py"
    },
    {
      "source": "/api/yd/download",
      "destination": "/api/yd_download.py"
    },
    {
      "source": "/uv/service/(.*)",
