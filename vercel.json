{
  "builds": [
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "package.json",
      "use": "@vercel/vite"
    }
  ],
  "functions": {
    "api/**/*.js": {
      "includeFiles": "bin/**"
    }
  },
  "routes": [
    {
      "src": "/api/yd/info",
      "dest": "/api/yd/info.js"
    },
    {
      "src": "/api/yd/download",
      "dest": "/api/yd/download.js"
    },
    {
      "src": "/uv/service/(.*)",
      "dest": "/index.html"
    },
    {
      "src": "/((?!api/|uv/|epoxy/|baremux/|bare/|assets/|thanawya/).*)",
      "dest": "/index.html"
    }
  ]
}
