{
  "rewrites": [
    {
      "source": "/uv/service/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/((?!api/|uv/|epoxy/|baremux/|bare/|assets/|thanawya/)(?!.*(?:\\.zip|\\.json|\\.txt|\\.png|\\.jpg|\\.jpeg|\\.webp|\\.opus|\\.mp3|\\.svg|\\.ico|\\.webmanifest)$).*)",
      "destination": "/index.html"
    }
  ]
}
