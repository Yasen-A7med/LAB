{
  "functions": {
    "api/yd/*.js": {
      "includeFiles": "bin/**"
    }
  },
  "rewrites": [
    {
      "source": "/uv/service/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/((?!api/|uv/|epoxy/|baremux/|bare/|assets/|thanawya/).*)",
      "destination": "/index.html"
    }
  ]
}
